[Unit]
Description=Mosaic broker
Documentation=man:mosaic(1)
Requires=mosaic-broker.socket
After=mosaic-broker.socket

[Service]
Type=simple
ExecStart=/usr/bin/mosaic daemon
# The framework raises thread priorities for audio, display and binder threads
# with setpriority, and RLIMIT_NICE caps how far that can go. The default of 0
# forbids anything above niceness 20, which makes every such call fail, and the
# system server treats some of them as fatal. 40 also allows niceness -20.
#
# This works only because the user manager was granted the same limit system
# side (system/user@.service.d/mosaic.conf): a service cannot raise its own hard
# limit, and the limit a user service inherits is the one its manager has.
LimitNICE=40
# The broker exits when idle (ADR-0005) and the socket unit starts it again on
# the next connection, so a clean exit is expected, not a failure.
Restart=no
# Nothing else may be running when the broker exits, and there is no session to
# prompt on: polkit authorization for UID allocation belongs to the terminal
# that ran `mosaic install`, not to the daemon. See ADR-0008.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# The registry lives in the user's data directory, because the broker is a user
# service and the app data directories it plans for are created by root separately
# (ADR-0008). ProtectHome makes the home read-only, so this path has to be named
# explicitly, and it is the one the work directory falls back to.
ReadWritePaths=%t/mosaic %h/.local/share/mosaic

[Install]
WantedBy=default.target
